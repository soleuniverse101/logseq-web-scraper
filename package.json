{
  "name": "logseq-web-scraper",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.html",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dev-logseq": "vite build --watch",
    "build-parser": "ohm generateBundles -e --withTypes src/**/*.ohm",
    "format": "prettier -w ."
  },
  "keywords": [],
  "author": "soleuniverse101",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@logseq/libs": "^0.0.17",
    "@types/gapi": "^0.0.47",
    "@types/gapi.client.youtube-v3": "^0.0.4",
    "prettier": "3.6.2",
    "vite": "^6.3.5"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/github",
        {
          "assets": [
            "logseq-web-scraper.zip"
          ]
        }
      ]
    ]
  },
  "logseq": {
    "title": "Logseq Web Scraper",
    "icon": "icon.png",
    "id": "_990n9u6uw"
  },
  "dependencies": {
    "neverthrow": "^8.2.0",
    "ohm-js": "^17.2.1"
  }
