Refltag {
  Statement =
    | Definition
    | Expression
  
  keywords =
    | "let"
  
  Definition = keyword<"let"> identifier "=" Expression

  Expression =
    | Lambda
    | FunctionCall
    | Term
  
  Lambda =
    | "(" ListOf<identifier, ","> ")" "=>" Expression -- parenthesized
    | identifier "=>" Expression -- freeForm
  
  FunctionCall =
    | Expression "(" ListOf<Expression, ","> ")" -- parenthesized
    | Expression NonemptyListOf<Expression, ","> -- freeForm
  
  Term =
    | Term ("+" | "-") Factor -- binary
    | Factor
  Factor =
    | Factor ("*" | "/") Primary -- binary
    | Primary

  Primary =
    | "(" Expression ")" -- parenthesized
    | identifier
    | literal

  identifier = ~keyword<keywords> (("_" | letter) identifierPart* "!"?) ~identifierPart
  keyword<k> = k ~identifierPart
  identifierPart = "_" | alnum

  literal = number | string
  number = digit+
  string = "\"" (~"\"" ("\\\"" | any))* "\""
  
  space :=  ~"\n" whitespace // Inline whitespace
  nonWhitespace = ~whitespace any
  whitespace = " " | "\t" | "\n" | "\r"
}
