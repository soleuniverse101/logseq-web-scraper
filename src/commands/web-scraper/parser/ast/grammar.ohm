Refltag {
  Block = Quantifier? Modes<blockMode>? selector? Template?
  Root = url Template?

  selector = (~"\n" any)+
  
  Template = "\n" (#(templateText) | TemplateEscape)*
  templateText = (~("{" | "}") any)+
  TemplateEscape = "{" Expression? "}"

  Quantifier = ("?" | "+" | "*") ","
  Modes<_mode> =  mode<_mode>+ ","
  mode<_mode> = "@" _mode ~"@"
  blockMode = "inline" | "zip"
  // root = "inline"

  // Statement =
  //   | Definition
  //   | Expression
  
  // keywords =
  //   | "let"
  
  // Definition = keyword<"let"> identifier "=" Expression

  Expression (an expression) =
  //   | Indexing
  //   | PropertyAccess
  //   | FunctionCall
  //   | Lambda
    | Term
  
  // Indexing = Expression "[" Expression "]"
  // PropertyAccess = Expression "." identifier

  // FunctionCall =
  //   | Expression "(" ListOf<Expression, ","> ")" -- parenthesized
  //   | Expression NonemptyListOf<Expression, ","> -- freeForm

  // Lambda =
  //   | "(" ListOf<identifier, ","> ")" "=>" Expression -- parenthesized
  //   | identifier "=>" Expression -- freeForm

  Term =
    | Term ("+" | "-") Factor -- binary
    | Factor
  Factor =
    | Factor ("*" | "/") Primary -- binary
    | Primary

  Primary =
    | "(" Expression ")" -- parenthesized
  //   | Object
  //   | Array
    | identifier
    | literal
    
  // Object = "{" ListOf<ObjectMapping, ","> "}"
  // ObjectMapping = identifier ":" Expression
  // Array = "[" ListOf<Expression, ","> "]"

  // identifier = ~keyword<keywords> (("$" | "_" | letter) identifierPart* "!"?) ~identifierPart
  identifier = /* ~keyword<keywords> */ letter identifierPart* ~identifierPart
  // keyword<k> = k ~identifierPart
  identifierPart = "_" | alnum

  url = nonWhitespace+ // Check at parsing function

  literal = number | string
  number = digit+
  string = "\"" (~"\"" ("\\\"" | any))* "\""
  
  space :=  ~"\n" whitespace // Inline whitespace
  nonWhitespace = ~whitespace any
  whitespace = " " | "\t" | "\n" | "\r"
}